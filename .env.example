# .env.example — 환경변수 템플릿
# 사용법: cp .env.example .env  그리고 실제 값으로 편집
#
# 주의:
#   - .env 파일을 git에 커밋하지 말 것 (.gitignore 에 추가되어 있어야 함)
#   - .env 파일 권한을 600으로 설정: chmod 600 .env
#   - 아래 값은 모두 더미(dummy)임. 실제 운영 값으로 반드시 교체할 것.

# ── API 키 ─────────────────────────────────────────────────────────────────
# 울산광역시 BIS / 국토부 TAGO 공공 API 키. 없으면 secret/key.txt 에서 fallback.
BUSHEXA_API_KEY=your-public-data-api-key

# ── 데이터베이스 ───────────────────────────────────────────────────────────
# SQLite 단일 백엔드 (postgres 제거됨). 컨테이너 /app 기준 → ./data 는 bind-mount.
DATABASE_URL=sqlite:///./data/bushexa.db

# ── Flask 보안 ─────────────────────────────────────────────────────────────
# 세션 서명 키 — 새로 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
BUSHEXA_SESSION_SECRET=change-me-to-a-long-random-string

# HTTPS 운영 시 반드시 true로 설정 (세션 쿠키 Secure 플래그, S1 보안 요구사항)
BUSHEXA_SESSION_COOKIE_SECURE=false

# ── 크롤러 튜닝 (선택 — 미설정 시 기본값) ─────────────────────────────────
# API HTTP 요청 타임아웃 초 (기본: 15. 울산 API 느린 응답 실측에 맞춤)
#BUSHEXA_API_TIMEOUT_SECONDS=15

# fetch 병렬화(E3/E4). 기본 1 = 기존 순차 루프(배포 무변경 게이트).
# 라이브 smoke 시 4로 켜고, 게이트 통과 후 유지 여부 결정. 문제 시 줄을 지우면 즉시 순차 복귀.
#BUSHEXA_GOVTRACK_FETCH_WORKERS=4
#BUSHEXA_ARRIVAL_FETCH_WORKERS=4

# 폴링 주기 기본값은 govtrack 15초 / arrival 7초 — admin 크롤 설정이 런타임 우선.
#BUSHEXA_ARRIVAL_POLL_SECONDS=7

# ── 로깅 ───────────────────────────────────────────────────────────────────
# 로그 레벨: DEBUG | INFO | WARNING | ERROR (기본: INFO)
BUSHEXA_LOG_LEVEL=INFO

# 로그 파일 저장 디렉터리 (기본: logs/)
BUSHEXA_LOG_DIR=logs
